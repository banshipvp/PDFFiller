{
  "name": "pdffiller",
  "version": "1.0.13",
  "description": "A local desktop PDF filling and signing app.",
  "author": "Local",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "PDF Filler",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && set ELECTRON_RUN_AS_NODE=&& electron .",
    "desktop:dev": "set ELECTRON_RUN_AS_NODE=&& set PDF_FILLER_DEV=1&& start /B npm run dev && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:win:portable": "npm run build && electron-builder --win portable --publish never",
    "dist:win:github": "npm run build && electron-builder --win nsis --publish always",
    "release:patch": "npm version patch && git push origin main --follow-tags",
    "release:minor": "npm version minor && git push origin main --follow-tags"
  },
  "build": {
    "appId": "com.local.pdffiller",
    "productName": "PDF Filler",
    "artifactName": "PDF-Filler-Setup-${version}.${ext}",
    "directories": {
      "output": "desktop-release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "banshipvp",
        "repo": "PDFFiller"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "installerHeaderIcon": "assets/app-icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Filler"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "icon": "assets/app-icon.ico",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2"
  }
}
